      "match_notes": "<p><span style=\"font-size:11pt\"><span style=\"font-family:Aptos,sans-serif\">Rochdale&nbsp;scored&nbsp;116&nbsp;all&nbsp;out&nbsp;and&nbsp;Burnley&nbsp;were&nbsp;30-1&nbsp;off&nbsp;11&nbsp;overs&nbsp;when&nbsp;rain&nbsp;came.&nbsp;</span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Aptos,sans-serif\">The&nbsp;20&nbsp;over&nbsp;Dls&nbsp;target&nbsp;the&nbsp;umpires&nbsp;and&nbsp;scorers&nbsp;decided&nbsp;was&nbsp;58&nbsp;so&nbsp;target&nbsp;of&nbsp;59.&nbsp;</span></span><span style=\"font-size:11pt\"><span style=\"font-family:Aptos,sans-serif\">So&nbsp;29&nbsp;more&nbsp;runs&nbsp;were&nbsp;required.&nbsp;</span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Aptos,sans-serif\">Burnley&nbsp;ended&nbsp;up&nbsp;on&nbsp;45&nbsp;having&nbsp;elected&nbsp;to&nbsp;chase&nbsp;the&nbsp;20&nbsp;over&nbsp;target&nbsp;in&nbsp;13&nbsp;overs</span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Aptos,sans-serif\">This&nbsp;resulted&nbsp;in&nbsp;Burnley&nbsp;bonus&nbsp;points&nbsp;-&nbsp;4&nbsp;points&nbsp;being&nbsp;within&nbsp;20&nbsp;runs&nbsp;plus&nbsp;2&nbsp;points&nbsp;for&nbsp;bowling&nbsp;Rochdale&nbsp;out.&nbsp;</span></span></p>\r\n",
