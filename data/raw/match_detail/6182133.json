      "match_notes": "<p>Match&nbsp;Abandoned&nbsp;-&nbsp;Dangerous&nbsp;Pitch.</p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">The&nbsp;umpires&nbsp;alone&nbsp;are&nbsp;the&nbsp;sole&nbsp;judges&nbsp;of&nbsp;Ground,&nbsp;Weather&nbsp;and&nbsp;Light.</span></span></span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">Their&nbsp;decision&nbsp;to&nbsp;abandon&nbsp;the&nbsp;match&nbsp;due&nbsp;to&nbsp;a&nbsp;dangerous&nbsp;pitch&nbsp;must&nbsp;stand.</span></span></span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">Consequently,&nbsp;both&nbsp;teams&nbsp;will&nbsp;initially&nbsp;receive&nbsp;nine&nbsp;(9)&nbsp;points&nbsp;for&nbsp;the&nbsp;abandoned&nbsp;match.</span></span></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><strong><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">The&nbsp;home&nbsp;Club&nbsp;are&nbsp;ultimately&nbsp;responsible&nbsp;for&nbsp;the&nbsp;preparation&nbsp;and&nbsp;performance&nbsp;of&nbsp;the&nbsp;pitch&nbsp;and&nbsp;will&nbsp;face&nbsp;the&nbsp;following&nbsp;additional&nbsp;sanctions;</span></span></strong></span></span></p>\r\n\r\n<ul>\r\n\t<li><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><strong><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">Penalised&nbsp;for&nbsp;providing&nbsp;a&nbsp;sub-standard&nbsp;playing&nbsp;surface&nbsp;-&nbsp;9&nbsp;points&nbsp;deducted&nbsp;from&nbsp;this&nbsp;match&nbsp;(zero&nbsp;return).</span></span></strong></span></span></li>\r\n\t<li><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><strong><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">A&nbsp;fine&nbsp;of&nbsp;&pound;150.</span></span></strong></span></span></li>\r\n\t<li><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><strong><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">The&nbsp;KCL&nbsp;will&nbsp;suspend&nbsp;this&nbsp;Fine,&nbsp;providing&nbsp;a&nbsp;Pitch&nbsp;Assessment&nbsp;with&nbsp;James&nbsp;Moss&nbsp;(Kent&nbsp;Cricket)&nbsp;is&nbsp;undertaken&nbsp;prior&nbsp;to&nbsp;the&nbsp;end&nbsp;of&nbsp;the&nbsp;season.</span></span></strong></span></span></li>\r\n\t<li><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><strong><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">The&nbsp;strip&nbsp;as&nbsp;used&nbsp;on&nbsp;Saturday&nbsp;(17<sup>th</sup>&nbsp;August&nbsp;2024)&nbsp;not&nbsp;to&nbsp;be&nbsp;used&nbsp;for&nbsp;any&nbsp;other&nbsp;KCL&nbsp;match&nbsp;in&nbsp;season&nbsp;2024.</span></span></strong></span></span></li>\r\n</ul>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">Jonathan&nbsp;Patterson&nbsp;&ndash;&nbsp;KCL&nbsp;Chair</span></span></span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">On&nbsp;behalf&nbsp;of&nbsp;the&nbsp;Management&nbsp;Committee.</span></span></span></span></p>\r\n\r\n<p><span style=\"font-size:11pt\"><span style=\"font-family:Calibri,sans-serif\"><span style=\"font-size:12.0pt\"><span style=\"font-family:CIDFont+F1\">Dated&nbsp;&ndash;&nbsp;22<sup>nd</sup>&nbsp;August&nbsp;2024</span></span></span></span></p>\r\n",
